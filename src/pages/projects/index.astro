---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, STATUS_LABEL } from '../../lib/content';
const projects = await getProjects();
const categories = [...new Set(projects.flatMap((p) => p.categories))].sort();
const statuses = [...new Set(projects.map((p) => p.status))];
---
<Base title="Projects" description="RTL design, verification and FPGA projects with status, tools and evidence.">
  <section class="blk" style="border-bottom:0">
    <div class="wrap">
      <div class="label">Portfolio</div>
      <h2>Projects</h2>
      <p class="lead">Each project states its real status. Open one for the design, verification approach, limitations and links.</p>

      <form class="filters" id="filters" role="search" onsubmit="return false">
        <label class="grow">Search
          <input type="search" id="q" placeholder="SPI, UVM, CDC, LPDDR5X…" autocomplete="off" />
        </label>
        <label>Category
          <select id="cat">
            <option value="">All categories</option>
            {categories.map((c) => <option value={c}>{c}</option>)}
          </select>
        </label>
        <label>Status
          <select id="st">
            <option value="">All statuses</option>
            {statuses.map((s) => <option value={s}>{STATUS_LABEL[s] ?? s}</option>)}
          </select>
        </label>
        <label>Sort
          <select id="sort">
            <option value="rec">Recommended</option>
            <option value="az">Title A–Z</option>
          </select>
        </label>
      </form>

      <p class="count" id="count" aria-live="polite">{projects.length} projects</p>
      <ul class="cards" id="list">
        {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
      </ul>
      <p class="empty" id="none" hidden>No projects match these filters. Clear the search or choose "All".</p>
      {projects.length === 0 && <p class="empty">No projects published yet.</p>}
    </div>
  </section>

  <script>
    const list = document.getElementById('list') as HTMLElement;
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-card]'));
    const q = document.getElementById('q') as HTMLInputElement;
    const cat = document.getElementById('cat') as HTMLSelectElement;
    const st = document.getElementById('st') as HTMLSelectElement;
    const sort = document.getElementById('sort') as HTMLSelectElement;
    const count = document.getElementById('count')!;
    const none = document.getElementById('none')!;

    function apply() {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((el) => {
        const ok =
          (!term || (el.dataset.search ?? '').includes(term)) &&
          (!cat.value || (el.dataset.cats ?? '').split('|').includes(cat.value)) &&
          (!st.value || el.dataset.status === st.value);
        el.hidden = !ok;
        if (ok) shown++;
      });
      const ordered = [...items].sort((a, b) =>
        sort.value === 'az'
          ? (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '')
          : Number(a.dataset.index) - Number(b.dataset.index));
      ordered.forEach((el) => list.appendChild(el));
      count.textContent = `${shown} of ${items.length} projects`;
      none.hidden = shown !== 0 || items.length === 0;
    }
    [q, cat, st, sort].forEach((c) => c.addEventListener('input', apply));
  </script>
</Base>
