---
import Base from '../layouts/Base.astro';
import { getResearch } from '../lib/content';
const items = await getResearch();
const KIND: Record<string, string> = { publication: 'Publication', 'literature-review': 'Literature review', 'academic-report': 'Academic report', presentation: 'Presentation', certification: 'Certification', article: 'Article' };
const STATUS: Record<string, string> = { published: 'Published', submitted: 'Submitted', ongoing: 'Ongoing', planned: 'Planned' };
---
<Base title="Research and learning" description="Reports, literature studies and technical reading.">
  <section class="blk" style="border-bottom:0">
    <div class="wrap">
      <div class="label">Research and learning</div>
      <h2>Reports and literature studies</h2>
      <p class="lead">Published, submitted, ongoing and planned work are labelled separately. Papers listed as reading are other authors' work.</p>
      <div class="timeline" style="margin-top:24px">
        {items.map((r) => (
          <div class="row">
            <div class="when">{r.year}<br /><span class="badge" style="margin-top:6px">{STATUS[r.status] ?? r.status}</span></div>
            <div>
              <div class="status">{KIND[r.kind] ?? r.kind}</div>
              <h3>{r.url ? <a href={r.url} target="_blank" rel="noopener noreferrer" style="border-bottom:1px solid var(--brown)">{r.title}</a> : r.title}</h3>
              <p class="note">{r.summary}</p>
            </div>
          </div>
        ))}
        {items.length === 0 && <p class="empty">Nothing here yet.</p>}
      </div>
    </div>
  </section>
</Base>
