---
import { STATUS_LABEL, type Project } from '../lib/content';
interface Props { project: Project; index?: number }
const { project: p, index = 0 } = Astro.props;
const search = [p.title, p.summary, ...p.tags, ...p.tools, ...p.categories].join(' ').toLowerCase();
---
<li data-card data-index={index} data-status={p.status} data-cats={p.categories.join('|')} data-title={p.title.toLowerCase()} data-search={search}>
  <a class="card" href={`/projects/${p.slug}/`}>
    <div class="top">
      <span class={`badge ${p.status}`}>{STATUS_LABEL[p.status] ?? p.status}</span>
      {p.featured && <span class="feat">FEATURED</span>}
    </div>
    <h3>{p.title}</h3>
    <p>{p.summary}</p>
    {p.tools.length > 0 && <div class="tools">{p.tools.join(' · ')}</div>}
  </a>
</li>
