---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getSettings, getProjects, getExperience, getSkills, LEVEL_LABEL } from '../lib/content';
const s = await getSettings();
const projects = await getProjects();
const featured = projects.filter((p) => p.featured).slice(0, 3);
const exp = (await getExperience()).filter((e) => e.kind === 'internship');
const learning = (await getSkills()).filter((k) => k.level === 'learning');
---
<Base>
  <section class="hero">
    <div class="wrap">
      <h1>
        <span class="name">{s.name}</span>
        {s.roleLines.map((r) => <span class="role">{r}</span>)}
      </h1>
      <p class="lead">{s.intro}</p>
      <div class="meta">
        <span><b>Now</b> {s.stage}</span>
        <span><b>Open to</b> {s.openTo}</span>
        <span><b>Location</b> {s.location}</span>
      </div>
      <div class="cta">
        <a class="btn fill" href="/projects/">Explore projects</a>
        {s.resumeUrl && <a class="btn" href={s.resumeUrl} download>Download résumé</a>}
        <a class="btn" href={s.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="btn" href={s.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </section>

  {exp.length > 0 && (
    <section class="blk" id="now">
      <div class="wrap">
        <div class="label">Currently</div>
        <div class="grid2">
          {exp.map((e) => (
            <div>
              <h2>Current role</h2>
              <div class="item">
                <div class="status">{e.current ? 'Current' : 'Previous'}</div>
                <h3>{e.title}</h3>
                <p class="org">{e.org}{e.location ? ` · ${e.location}` : ''}</p>
                {e.note && <p class="note">{e.note}</p>}
              </div>
            </div>
            <div>
              <h2>Upcoming work</h2>
              {e.upcoming ? (
                <div class="item"><div class="status">Upcoming</div><h3>{e.upcoming}</h3></div>
              ) : <p class="note">Nothing announced yet.</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="blk">
    <div class="wrap">
      <div class="label">Selected work</div>
      <h2>Featured projects</h2>
      <p class="lead">Status is shown on every project. Results and coverage are published only when they exist.</p>
      {featured.length ? (
        <ul class="cards">{featured.map((p, i) => <ProjectCard project={p} index={i} />)}</ul>
      ) : <p class="empty">No featured projects yet.</p>}
      <p style="margin-top:24px"><a class="btn" href="/projects/">All projects</a></p>
    </div>
  </section>

  {learning.length > 0 && (
    <section class="blk">
      <div class="wrap">
        <div class="label">Focus</div>
        <h2>Currently learning</h2>
        <div class="tags">{learning.map((k) => <span>{k.name}</span>)}</div>
        <p class="note">Full list with evidence on the <a href="/skills/" style="border-bottom:1px solid var(--brown)">skills page</a> ({LEVEL_LABEL.used}, {LEVEL_LABEL.working}, {LEVEL_LABEL.learning}).</p>
      </div>
    </section>
  )}

  <section class="blk" id="contact" style="border-bottom:0">
    <div class="wrap">
      <div class="label">Contact</div>
      <p class="lead" style="margin-bottom:20px">Looking for {s.openTo} in Bengaluru.</p>
      <a class="contact-mail" href={`mailto:${s.email}`}>{s.email}</a>
      <div class="links">
        <a href={s.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={s.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        {s.resumeUrl && <a href={s.resumeUrl} download>Résumé (PDF)</a>}
      </div>
    </div>
  </section>
</Base>
