---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="nf">
    <div class="wrap">
      <div class="label">404</div>
      <h1 style="font-size:clamp(30px,5vw,44px)">Page not found</h1>
      <p class="lead" style="margin-top:14px">The page does not exist or has moved.</p>
      <div class="cta"><a class="btn fill" href="/">Home</a><a class="btn" href="/projects/">Projects</a></div>
    </div>
  </section>
</Base>
