# Copy to .env for local development. Never commit .env.
# Leave SANITY_PROJECT_ID empty to build from the local seed data in src/data/seed/.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only for previewing unpublished drafts locally. Create a Viewer token in Sanity (manage.sanity.io > API > Tokens).
SANITY_PREVIEW=false
SANITY_READ_TOKEN=
# Final public URL (used for canonical links and the sitemap).
SITE_URL=https://zesty-choux-f5121f.netlify.app
